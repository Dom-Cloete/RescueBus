@model domRescueBus.Models.ManagementViewModel

@{
    ViewBag.Title = "Management";
}

<h2 class="accent-heading">Driver and Vehicle Management</h2>

@* drivers section *@
<div class="row mb-5">
    <div class="col-md-12">
        <div class="card shadow-sm">
            @* header section with add button *@
            <div class="card-header management-card-header-drivers d-flex justify-content-between align-items-center">
                <h4 class="mb-0">Drivers</h4>
                <button type="button" class="btn management-add-button btn-sm" data-bs-toggle="modal" data-bs-target="#createDriverModal">
                    <i class="bi bi-plus-circle"></i> Add New Driver
                </button>
            </div>

            @* search driver section *@
            <div class="card-body">
                <form id="searchDriverForm">
                    <div class="row g-3 align-items-end">
                        <div class="col-md-4">
                            <input type="text" class="form-control" id="driverSearchName" placeholder="Driver Name">
                        </div>
                        <div class="col-md-4">
                            <select class="form-select" id="driverSearchServiceType">
                                @foreach (var service in Model.ServiceTypes)
                                {
                                    <option value="@service.Id">@service.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <button type="button" class="btn btn-outline-primary me-2" id="searchDriversBtn"><i class="bi bi-search"></i> Search Drivers</button>
                            <button type="button" class="btn btn-outline-secondary" id="clearSearchBtn"><i class="bi bi-x-circle"></i> Clear Search</button>
                        </div>
                    </div>
                </form>
            </div>

            @* list with current drivers *@
            <div class="card-body p-0">
                <div id="driversListContainer" class="list-group list-group-flush">
                </div>
                <p id="noDriversMessage" class="management-no-results-message" style="display: none;">No drivers found.</p>
            </div>
        </div>
    </div>
</div>

@* vehicles section *@
<div class="row mb-5">
    <div class="col-md-12">
        <div class="card shadow-sm">
            @* header section with add button *@
            <div class="card-header management-card-header-vehicles d-flex justify-content-between align-items-center">
                <h4 class="mb-0">Vehicles</h4>
                <button type="button" class="btn management-add-button btn-sm" data-bs-toggle="modal" data-bs-target="#createVehicleModal">
                    <i class="bi bi-plus-circle"></i> Add New Vehicle
                </button>
            </div>

            @* list with current vehicles *@
            <div class="card-body p-0">
                <div id="vehiclesListContainer" class="list-group list-group-flush">
                </div>
                <p id="noVehiclesMessage" class="management-no-results-message" style="display: none;">No vehicles found.</p>
            </div>

            @* footer with export vehicles button *@
            <div class="card-footer d-flex justify-content-end">
                <a href="@Url.Action("ExportVehicles", "Home")" class="btn export-vehicles-button">
                    <i class="bi bi-download"></i> Export Vehicles
                </a>
            </div>
        </div>
    </div>
</div>

@* CRUD sections for driver *@
@* create driver modal *@
<div class="modal fade" id="createDriverModal" tabindex="-1" aria-labelledby="createDriverModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="createDriverForm">
                <div class="modal-header management-modal-header-add-driver text-white">
                    <h5 class="modal-title" id="createDriverModalLabel">Add New Driver</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="newDriverName" class="form-label">Driver Name</label>
                        <input type="text" class="form-control" id="newDriverName" required>
                    </div>
                    <div class="mb-3">
                        <label for="newDriverPhone" class="form-label">Phone Number</label>
                        <input type="text" class="form-control" id="newDriverPhone" required>
                    </div>
                    <div class="mb-3">
                        <label for="newDriverServiceId" class="form-label">Service Type</label>
                        <select class="form-select" id="newDriverServiceId" required>
                            @foreach (var service in Model.ServiceTypes.Where(s => s.Id != 0))
                            {
                                <option value="@service.Id">@service.Name</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="newDriverImage" class="form-label">Driver Image</label>
                        <select class="form-select" id="newDriverImage">
                            <option value="~/Content/Images/driver_1.jpg">Driver 1</option>
                            <option value="~/Content/Images/driver_2.jpg">Driver 2</option>
                            <option value="~/Content/Images/driver_3.jpg">Driver 3</option>
                            <option value="~/Content/Images/driver_4.jpg">Driver 4</option>
                            <option value="~/Content/Images/driver_5.jpg">Driver 5</option>
                            <option value="~/Content/Images/driver_6.jpg">Driver 6</option>
                            <option value="~/Content/Images/driver_7.jpg">Driver 7</option>
                            <option value="~/Content/Images/driver_8.jpg">Driver 8</option>
                            <option value="~/Content/Images/driver_9.jpg">Driver 9</option>
                            <option value="~/Content/Images/driver_10.jpg">Driver 10</option>
                        </select>
                        <img id="newDriverImagePreview" src="#" alt="Image Preview" class="img-thumbnail mt-2" style="max-width: 100px; max-height: 100px;">
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success">Save Driver</button>
                </div>
            </form>
        </div>
    </div>
</div>

